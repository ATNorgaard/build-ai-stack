# Guiden kalder OpenRouter (https://openrouter.ai/keys). Lokalt proxyer Vite-dev-serveren /api/guide,
# så nøglen aldrig når browseren. I produktion sættes den som secret på edge-funktionen.
OPENROUTER_API_KEY=
# Valgfrit: OpenRouter model-id (standard deepseek/deepseek-v4.1-flash) og reasoning (none/low/medium/high, standard none).
GUIDE_MODEL=
GUIDE_REASONING=

# Optional: when both are set, solutions and questions are saved to Supabase
# instead of the browser's localStorage. Leave empty for the local-only app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: where the guide endpoint lives in production (Supabase Edge Function URL).
# Defaults to /api/guide, which the Vite dev server serves locally.
VITE_GUIDE_URL=
